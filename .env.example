# UWAL — environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local`
# is gitignored so your real secrets never reach GitHub.
#
#   cp .env.example .env.local
#
# Every variable below is required UNLESS marked optional.

# ── Supabase (auth + database) ─────────────────────────────────────
# Create a project at https://supabase.com, then copy these from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side admin client (used by /api/v1/* routes that authenticate
# extension requests via Bearer workspace tokens). Found in the same
# Project Settings → API page; KEEP THIS SECRET.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override the post-auth redirect URL used by sign-up /
# magic-link flows. Defaults to `${window.location.origin}/auth/callback`,
# which works for both localhost and production. Only set this if
# you're testing auth from a non-default origin.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ── AI (pick ONE provider path) ────────────────────────────────────
# Path A · Vercel AI Gateway (recommended): one key, every model.
# Get it from https://vercel.com/dashboard → AI → API Keys.
AI_GATEWAY_API_KEY=your-gateway-key

# Path B · Direct provider keys (fallback). Uncomment whichever you
# use; the AI SDK auto-detects them. You only need these if you opt
# OUT of the gateway.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Vercel Blob (screenshot storage) ───────────────────────────────
# Auto-bound when you connect the Blob integration on Vercel; for
# local dev, generate a token at https://vercel.com/dashboard/stores
# and paste it here.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
